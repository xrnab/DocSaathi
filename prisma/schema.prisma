// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String   @id @default(uuid())
  clerkUserId String   @unique // Clerk's user ID
  email       String   @unique
  name        String?
  imageUrl    String?
  role        UserRole @default(UNASSIGNED) // UNASSIGNED, PATIENT, DOCTOR, ADMIN
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  gender      String?  // Male, Female

  // Patient-specific fields
  credits Int @default(2) // Accumulated credit balance
  bloodType String?
  dateOfBirth DateTime?
  age         Int?
  height      Float? // in cm or inches
  weight      Float? // in kg or lbs
  medicalHistory String? @db.Text
  allergies      String? @db.Text
  medications    String? @db.Text
  isProfileComplete Boolean @default(false)
  village           String? // Patient's village/town (optional, e.g. for Nabha regional mapping)

  // ASHA-specific fields
  ashaId            String?
  block             String?

  // Doctor-specific fields
  specialty          String?
  experience         Int? // Years of experience
  credentialUrl      String? // Document URL
  description        String?             @db.Text
  verificationStatus VerificationStatus? @default(PENDING)
  languages          String[]            @default([])

  // Relations
  patientAppointments Appointment[]       @relation("PatientAppointments")
  doctorAppointments  Appointment[]       @relation("DoctorAppointments")
  availabilities      Availability[]
  transactions        CreditTransaction[]
  payouts             Payout[]
  notifications       Notification[]
  prescriptions       Prescription[]      @relation("PatientPrescriptions")
  vaccinations        Vaccination[]       @relation("PatientVaccinations")
  ashaFamilies        AshaFamily[]        @relation("AshaFamilies")
  outbreakReports     OutbreakReport[]    @relation("AshaOutbreaks")
  patientEmergencies  EmergencyRequest[]  @relation("PatientEmergencies")
  doctorQueue         DoctorQueue?        @relation("DoctorQueue")
}

model Prescription {
  id        String   @id @default(uuid())
  patientId String
  patient   User     @relation("PatientPrescriptions", fields: [patientId], references: [id], onDelete: Cascade)
  name      String
  dosage    String
  frequency String
  duration  String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Vaccination {
  id        String   @id @default(uuid())
  patientId String
  patient   User     @relation("PatientVaccinations", fields: [patientId], references: [id], onDelete: Cascade)
  name      String
  date      DateTime
  provider  String
  createdAt DateTime @default(now())
}

enum UserRole {
  UNASSIGNED
  PATIENT
  DOCTOR
  ADMIN
  OWNER
  ASHA_WORKER
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

model Availability {
  id        String     @id @default(uuid())
  doctorId  String
  doctor    User       @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  startTime DateTime
  endTime   DateTime
  status    SlotStatus @default(AVAILABLE)

  @@index([doctorId, startTime])
}

enum SlotStatus {
  AVAILABLE
  BOOKED
  BLOCKED
}

model Appointment {
  id                 String            @id @default(uuid())
  patientId          String
  patient            User              @relation("PatientAppointments", fields: [patientId], references: [id])
  doctorId           String
  doctor             User              @relation("DoctorAppointments", fields: [doctorId], references: [id])
  startTime          DateTime // Start time of appointment
  endTime            DateTime // End time of appointment
  status             AppointmentStatus @default(SCHEDULED)
  notes              String?           @db.Text
  patientDescription String?           @db.Text

  // Feedback & Grading (Report Card)
  grading            String? // e.g. "A+", "8.5", "Great"
  improvementStatus  String? // e.g. "Improving", "Stable"
  doctorSummary      String? @db.Text

  // Video session fields
  videoSessionId    String? // Vonage Video API Session ID
  videoSessionToken String? // Optional: Can store tokens if needed
  reminderSent      Boolean           @default(false)
  queueToken        Int?     // Token number assigned when queued
  queuePosition     Int?     // Current position in queue

  // Voice Notes
  voiceNotes        VoiceNote[]
  chatMessages      ChatMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, startTime])
  @@index([doctorId, startTime])
}

enum AppointmentStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  REJECTED
}

model CreditTransaction {
  id        String          @id @default(uuid())
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount    Int // Positive for additions, negative for usage
  type      TransactionType
  packageId String? // Reference to which package was purchased
  createdAt DateTime        @default(now())
}

enum TransactionType {
  CREDIT_PURCHASE // Credits purchased through Clerk Billing
  APPOINTMENT_DEDUCTION // Credit used for appointment
  ADMIN_ADJUSTMENT // Manual adjustment by admin
}

model Payout {
  id          String       @id @default(uuid())
  doctorId    String
  doctor      User         @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  amount      Float // Total payout amount in USD
  credits     Int // Number of credits being paid out
  platformFee Float // Platform fee deducted (2 USD per credit)
  netAmount   Float // Amount doctor receives (8 USD per credit)
  upiId         String // Doctor's UPI ID for payout
  accountNumber String? // Optional bank account number
  ifscCode      String? // Optional IFSC code
  status      PayoutStatus @default(PROCESSING)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  processedAt DateTime? // When admin marked it as processed
  processedBy String? // Admin who processed it

  @@index([status, createdAt])
  @@index([doctorId, status])
}

enum PayoutStatus {
  PROCESSING
  PROCESSED
}

model AshaFamily {
  id        String             @id @default(uuid())
  ashaId    String
  asha      User               @relation("AshaFamilies", fields: [ashaId], references: [id], onDelete: Cascade)
  headName  String
  village   String
  block     String
  pincode   String?
  createdAt DateTime           @default(now())
  members   AshaFamilyMember[]
}

model AshaFamilyMember {
  id            String     @id @default(uuid())
  familyId      String
  family        AshaFamily @relation(fields: [familyId], references: [id], onDelete: Cascade)
  name          String
  age           Int
  gender        String
  relation      String // Head, Wife, Son, Daughter, etc.
  immunisations String?    @db.Text // JSON or text list of immunisations and dates
  createdAt     DateTime   @default(now())
}

model OutbreakReport {
  id           String   @id @default(uuid())
  reportedById String
  reportedBy   User     @relation("AshaOutbreaks", fields: [reportedById], references: [id], onDelete: Cascade)
  symptoms     String[] // list of symptoms
  village      String
  block        String
  caseCount    Int
  notes        String?  @db.Text
  createdAt    DateTime @default(now())
}

model SymptomSubmission {
  id          String   @id @default(uuid())
  symptoms    String[]
  duration    String
  patientType String
  language    String
  village     String?
  createdAt   DateTime @default(now())
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  message   String
  type      NotificationType
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId, read])
}

enum NotificationType {
  APPOINTMENT
  REMINDER
  PAYOUT
  SYSTEM
}

model VoiceNote {
  id            String      @id @default(uuid())
  appointmentId String
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  fromRole      String      // PATIENT or DOCTOR
  transcript    String      @db.Text
  audioUrl      String?
  createdAt     DateTime    @default(now())

  @@index([appointmentId])
}

model ChatMessage {
  id            String      @id @default(uuid())
  appointmentId String
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  senderRole    String      // "PATIENT" or "DOCTOR"
  text          String      @db.Text
  createdAt     DateTime    @default(now())
}

model EmergencyRequest {
  id          String   @id @default(uuid())
  patientId   String
  patient     User     @relation("PatientEmergencies", fields: [patientId], references: [id])
  latitude    Float?
  longitude   Float?
  address     String?
  status      EmergencyStatus @default(ACTIVE)
  message     String?  @db.Text
  respondedBy String?
  createdAt   DateTime @default(now())
  resolvedAt  DateTime?
  @@index([status, createdAt])
}

enum EmergencyStatus {
  ACTIVE
  RESPONDING
  RESOLVED
}

model DoctorQueue {
  id            String   @id @default(uuid())
  doctorId      String   @unique
  doctor        User     @relation("DoctorQueue", fields: [doctorId], references: [id])
  currentToken  Int      @default(0)  // Token being served right now
  totalTokens   Int      @default(0)  // Tokens issued today
  avgMinutes    Int      @default(10) // Avg consultation minutes
  isActive      Boolean  @default(false)
  date          DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

